# Same bot token from BotFather — used to verify Telegram Mini App initData.
BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRstuVwxYZ

# Port the server listens on locally.
PORT=3001

# Where your frontend is hosted, once deployed (e.g. https://your-app.vercel.app).
# Using * is fine for local testing only — lock this down before going live.
CORS_ORIGIN=*

# SQLite file path (created automatically).
DB_PATH=cartela.db

# Your Mini App's HTTPS URL (ngrok URL for testing, real domain in production).
# Used by /playbingo to build the "open game" button, and can be reused
# for BotFather's Menu Button setting too.
MINI_APP_URL=https://your-ngrok-or-real-url.example.com

# Secret required to access /admin (the admin dashboard). Set this to a
# long random string and keep it private — anyone with it can adjust any
# player's balance and approve/reject withdrawals. Leave it unset to
# disable the admin dashboard entirely.
ADMIN_SECRET=change-this-to-a-long-random-string

